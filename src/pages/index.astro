---
import "../styles/global.css";

/**
 * La página de Terminus.
 *
 * **Enseña el producto antes de describirlo.** La captura de la aplicación
 * entra en los primeros 600 px y queda recortada por el borde de la pantalla a
 * propósito: quien llega ve la cosa funcionando y decide si le sirve sin leer
 * un párrafo. Es HTML, no una imagen — se lee con lector de pantalla, escala
 * sin pixelarse, y los rótulos están copiados de la app («tarea», «material»,
 * «carpeta de trabajo», «Memoria», «solo lectura»), no inventados para la
 * foto. Una captura que promete una interfaz que no existe se paga en la
 * primera instalación.
 *
 * **La página es de Terminus; Danil la firma.** Arriba va el icono real de la
 * aplicación —el mismo que va a quedar en el menú de inicio— y abajo, una sola
 * vez, el wordmark de la casa. Poner las dos marcas al mismo peso obliga a
 * quien llega a decidir de quién es esto antes de saber qué es.
 *
 * **No promete lo que la app todavía no hace.** Hoy no está firmada con un
 * certificado del sistema, así que Windows avisa en la primera instalación, y
 * macOS no tiene instalador publicado. Las dos cosas se dicen aquí —con su
 * sección propia y un enlace desde el botón mismo— en vez de que alguien las
 * descubra al abrir el instalador: un aviso rojo del sistema operativo que
 * nadie anticipó es lo que hace que la gente cierre y no vuelva.
 *
 * **Y no hay número de versión escrito.** El enlace apunta a la release más
 * reciente, que es la que GitHub resuelve sola. Un número aquí se queda viejo
 * el día que se publique la siguiente, y nadie se acuerda de venir a cambiarlo.
 */
const RELEASES = "https://github.com/soydanil/terminus/releases/latest";
/**
 * **Nombre estable, sin versión dentro.** Escribir
 * `Terminus_0.1.3_x64-setup.exe` aquí rompe el botón el día que salga la
 * siguiente: `latest` resuelve la release, pero el nombre del archivo tiene que
 * existir tal cual dentro de ella. Cada release publica además una copia con
 * este nombre, y así el enlace no caduca.
 */
const DESCARGA = `${RELEASES}/download/Terminus-Windows-Setup.exe`;
/** El icono de la app instalada. Es el isotipo de Danil: la misma marca. */
const ICONO = "/marca/terminus-icono.png";
/**
 * **Nombre estable del instalador de macOS, sin versión dentro.** Igual que el
 * de Windows: `latest` resuelve la release y este nombre tiene que existir tal
 * cual dentro de ella. Cada release publica esta copia, y su corrida se cae si
 * no se puede descargar — el botón no puede quedarse apuntando a un 404 sin que
 * alguien se entere.
 *
 * Es **Apple Silicon**: el git que la app trae dentro se empaqueta desde la
 * máquina que compila, así que un binario universal llevaría un git de una sola
 * arquitectura. Un Mac Intel usaría el git del sistema, camino que la app cubre,
 * pero no recibe actualizaciones automáticas: `latest.json` solo declara arm64,
 * a propósito, para no mandarle un binario que no puede ejecutar.
 */
const DESCARGA_MAC = `${RELEASES}/download/Terminus-macOS.dmg`;
/** El repositorio público de Terminus. */
const REPO = "https://github.com/soydanil/terminus";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Terminus — el agente no puede escribir tu repo</title>
    <meta
      name="description"
      content="Aplicación de escritorio que corre Claude Code y Codex contra los repositorios de tu organización. El agente no tiene permiso de escritura sobre el repositorio. Lee en solo lectura y escribe en una carpeta de trabajo aparte."
    />
    <meta property="og:title" content="Terminus" />
    <meta
      property="og:description"
      content="El agente no tiene permiso de escritura sobre tu repositorio."
    />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a0d23" />
    <link rel="canonical" href="https://terminus.danil.ai/" />
    <link rel="icon" href={ICONO} type="image/png" />
    <link rel="apple-touch-icon" href={ICONO} />
    <!-- Las fuentes son lo primero que se ve; se precargan para que el titular
         no se dibuje dos veces con dos tipografías distintas. -->
    <link
      rel="preload"
      href="/fuentes/Geist-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fuentes/GeistMono-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body>
    <!-- El fondo. Cuatro capas fijas detrás de todo: rejilla, luz, viñeta y
         grano. Las dos primeras se mueven a distinta velocidad al hacer scroll
         —de ahí la profundidad— y ninguna captura el ratón. -->
    <div class="fondo" aria-hidden="true">
      <div class="fondo__capa fondo__rejilla" data-parallax="0.05"></div>
      <div class="fondo__capa fondo__luz" data-parallax="0.16"></div>
      <div class="fondo__capa fondo__vineta"></div>
      <div class="fondo__capa fondo__grano"></div>
    </div>
    <div class="reglas" aria-hidden="true"><div class="reglas__caja"></div></div>

    <header class="nav">
      <div class="envoltura nav__fila">
        <a class="marca" href="/">
          <span class="marca__placa">
            <img src={ICONO} alt="" width="17" height="17" />
          </span>
          Terminus
        </a>
        <nav class="nav__acciones" aria-label="Principal">
          <a class="nav__enlace" href="#instalar">Instalación</a>
          <a class="nav__enlace" href="#estado">Estado</a>
          <a class="boton boton--accion boton--chico" href={DESCARGA}>
            Descargar
          </a>
        </nav>
      </div>
    </header>

    <main>
      <!-- ================================================================
           Hero: la promesa, y debajo la cosa funcionando.
           =============================================================== -->
      <section class="envoltura hero">
        <div class="hero__texto">
          <p class="pastilla">Aplicación de escritorio · Windows</p>
          <h1>Dale trabajo real a la IA. No acceso real a tu empresa.</h1>
          <p class="hero__bajada">
            Claude Code y Codex corren dentro de la aplicación, contra los
            repos de tu organización. Leen todo. Escriben solo en su propia
            carpeta de trabajo, separada de tu código.
          </p>
          <!-- La instalación vive en el hero, no en una sección lejana: el
               botón y el comando lado a lado, mismo peso. El botón es el camino
               de un clic; el comando, el de quien ya tiene Node. Cada uno con
               una nota corta que acota su alcance. -->
          <div class="hero__lanzador">
            <div class="hero__instalar" id="instalar">
              <div class="hero__via">
                <a class="boton boton--accion boton--grande" href={DESCARGA}>
                  <svg
                    class="boton__glifo"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      d="M3 5.6 10.4 4.5v7.1H3zM11.6 4.3 21 3v8.6h-9.4zM3 12.5h7.4v7.1L3 18.5zM11.6 12.5H21V21l-9.4-1.3z"
                    ></path>
                  </svg>
                  Descargar para Windows
                </a>
                <p class="hero__via-nota">Un clic, sin terminal.</p>
              </div>
              <div class="hero__via">
                <div class="comando">
                  <code>npx @soydanil/terminus</code>
                  <button
                    class="comando__copiar"
                    type="button"
                    data-copiar="npx @soydanil/terminus"
                  >
                    Copiar
                  </button>
                </div>
                <p class="hero__via-nota">Si ya tienes Node.</p>
              </div>
            </div>

            <!-- macOS. El botón está porque el archivo existe: cada release
                 publica su .dmg con este nombre. El día que dejara de existir,
                 lo que hay que quitar es esto — no apagar un interruptor que
                 nadie volvería a mirar. -->
            <a
              class="boton boton--linea boton--grande hero__mac-boton"
              href={DESCARGA_MAC}
            >
              <svg
                class="boton__glifo"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M16.4 12.7c0-2.2 1.8-3.3 1.9-3.4-1-1.5-2.6-1.7-3.2-1.7-1.4-.1-2.6.8-3.3.8s-1.7-.8-2.9-.8c-1.5 0-2.9.9-3.6 2.2-1.6 2.7-.4 6.7 1.1 8.9.7 1.1 1.6 2.3 2.7 2.2 1.1 0 1.5-.7 2.8-.7s1.6.7 2.8.7 1.9-1.1 2.6-2.1c.8-1.2 1.2-2.4 1.2-2.4s-2.2-.9-2.4-3.6zM14.3 6.1c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.5.6-1 1.6-.9 2.6 1 .1 1.9-.5 2.5-1.2z" />
              </svg>
              Descargar para macOS
            </a>

            <!-- El aviso de Windows se enuncia aquí, pegado al botón, y no al
                 final de la página. Enterarse después de descargar es la forma
                 más rápida de perder a alguien. -->
            <p class="hero__requisitos">
              <span class="mono">Windows 10 u 11 · 64 bits</span>
              <span class="punto" aria-hidden="true">·</span>
              <span>Se actualiza sola</span>
              <span class="punto" aria-hidden="true">·</span>
              <a class="hero__aviso" href="#estado">
                Windows avisa la primera vez
              </a>
              <span class="punto" aria-hidden="true">·</span>
              <a
                class="hero__aviso"
                href="mailto:hola@danil.ai?subject=Gobernanza%20de%20agentes"
              >
                ¿Agentes contra producción a escala? Hablemos
              </a>
            </p>

            <!-- Los agentes con los que corre, pegados a la instalación — la
                 fila «Works with» de la referencia. Monocromo, los mismos glifos
                 que la sección de compatibilidad de más abajo. -->
            <div class="hero__compat">
              <span class="hero__compat-rotulo">Funciona con</span>
              <div class="hero__agentes">
                <span class="hero__agente">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 18 8 6 13 18M11 18 16 6 21 18" />
                  </svg>
                  Claude Code
                </span>
                <span class="hero__agente">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 4a4 4 0 0 1 4 4 4 4 0 0 1 4 4 4 4 0 0 1-4 4 4 4 0 0 1-4 4 4 4 0 0 1-4-4 4 4 0 0 1-4-4 4 4 0 0 1 4-4 4 4 0 0 1 4-4z" />
                  </svg>
                  Codex
                </span>
                <span class="hero__agente">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <path d="M5 5 19 19M19 5 5 19" />
                  </svg>
                  Grok
                </span>
                <span class="hero__agente">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="13" r="7" />
                    <path d="M12 16.5V9M9 12l3-3 3 3" />
                  </svg>
                  Antigravity
                </span>
                <span class="hero__agente">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="M7 10l3 2-3 2M13 15h4" />
                  </svg>
                  OpenCode
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- La aplicación. Tres columnas, como en el escritorio: de dónde lee,
             la conversación, y lo que la tarea dejó escrito. -->
        <figure class="marco" aria-label="La ventana de Terminus con una tarea abierta">
          <div class="ventana__barra">
            <span class="marca__placa" aria-hidden="true">
              <img src={ICONO} alt="" width="17" height="17" />
            </span>
            <span class="ventana__titulo">Terminus</span>
            <span class="ventana__controles" aria-hidden="true">
              <span>—</span><span>▢</span><span>✕</span>
            </span>
          </div>

          <div class="ventana__cuerpo">
            <!-- Barra lateral: tareas agrupadas en proyectos. -->
            <div class="panel panel--izq">
              <div class="boton-app">
                <svg class="icono" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7" />
                  <path d="M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4z" />
                </svg>
                Nueva tarea
              </div>

              <p class="panel__rotulo" style="margin-top: 0.4rem;">Proyectos</p>
              <div class="fila">
                <svg class="icono" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 4h5l2 2h9v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z" />
                </svg>
                <span class="fila__nombre">Facturación</span>
              </div>
              <div class="fila fila--hija fila--activa">
                <span class="fila__nombre">Cambio de plan a mitad de mes</span>
              </div>
              <div class="fila fila--hija">
                <span class="fila__nombre">Qué ve el cliente al bajar de plan</span>
              </div>
              <div class="fila">
                <svg class="icono" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 4h5l2 2h9v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z" />
                </svg>
                <span class="fila__nombre">Onboarding</span>
              </div>

              <p class="panel__rotulo" style="margin-top: 0.6rem;">Recientes</p>
              <div class="fila">
                <svg class="icono" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3 2" />
                </svg>
                <span class="fila__nombre">Límites del plan Starter</span>
              </div>
              <div class="fila">
                <svg class="icono" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3 2" />
                </svg>
                <span class="fila__nombre">Qué pasa si falla un pago</span>
              </div>

              <div class="fila" style="margin-top: 0.75rem;">
                <svg class="icono" viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="12" rx="1" />
                  <path d="M2 20h20" />
                </svg>
                <span class="fila__nombre">Esta computadora</span>
                <svg class="icono" viewBox="0 0 24 24" aria-hidden="true" style="margin-left: auto;">
                  <path d="m7 15 5 5 5-5M7 9l5-5 5 5" />
                </svg>
              </div>
            </div>

            <!-- Conversación. Sin avatares: el lado y el fondo ya dicen quién
                 habla, que es lo que decide la app. -->
            <div class="panel panel--centro">
              <div class="franja">
                <span class="franja__titulo">Cambio de plan a mitad de mes</span>
                <span class="franja__dato">$0,04</span>
                <span class="franja__dato">Memoria</span>
                <span class="medidor" aria-hidden="true">
                  <span class="medidor__lleno" style="width: 18%;"></span>
                </span>
                <span class="franja__dato">14k / 200k</span>
                <span class="franja__dato" style="margin-left: auto;">
                  Artefactos (3)
                </span>
              </div>

              <div class="hilo">
                <p class="dicho">
                  Si un cliente cambia de plan a mitad de mes, ¿qué se le cobra?
                  Se lo tengo que explicar hoy y no quiero inventármelo.
                </p>

                <div>
                  <p class="firma">
                    <span class="firma__agente">Claude Code</span>
                    <span class="firma__cuenta">marta@acme.com</span>
                  </p>

                  <div class="linea" style="margin: 0.5rem 0 0.65rem;">
                    <p class="acto">
                      <svg class="icono" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <path d="M14 2v6h6" />
                      </svg>
                      <span class="acto__verbo">Leyó 14 archivos</span>
                      <span class="acto__sujeto">acme-api/billing</span>
                    </p>
                    <p class="acto">
                      <svg class="icono" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" />
                        <path d="m20 20-3.5-3.5" />
                      </svg>
                      <span class="acto__verbo">Buscó 3 veces</span>
                      <span class="acto__sujeto">prorrateo</span>
                    </p>
                    <p class="acto">
                      <svg class="icono" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7" />
                        <path d="M18.5 2.5a2.1 2.1 0 0 1 3 3L13 12l-4 1 1-4z" />
                      </svg>
                      <span class="acto__verbo">Escribió</span>
                      <span class="acto__sujeto">cambio-de-plan.md</span>
                      <span class="acto__marca">+42</span>
                    </p>
                  </div>

                  <p class="respuesta">
                    Se le cobra <strong>la parte proporcional a los días que
                    quedan del mes</strong>, y el cargo aparece en la factura
                    siguiente, no al instante. Si el plan nuevo es más barato no
                    hay devolución: queda como saldo a favor para el mes que
                    viene. Te dejé el detalle y la frase exacta que puedes
                    copiarle al cliente.
                  </p>

                  <p class="entrega" style="margin-top: 0.65rem;">
                    <svg class="icono" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                      <path d="M14 2v6h6" />
                      <path d="M12 12v6M9 15h6" />
                    </svg>
                    Produjo
                    <span class="entrega__ruta">cambio-de-plan.md</span>
                    <span class="entrega__peso">12,4 kB</span>
                  </p>
                </div>
              </div>

              <div class="compositor">
                <p class="compositor__contexto">
                  Contexto:
                  <span class="sello">acme-api · main</span>
                  <span class="sello">docs-producto · main</span>
                </p>
                <div class="compositor__fila">
                  <span class="tecla-redonda" aria-hidden="true">
                    <svg class="icono" viewBox="0 0 24 24">
                      <path d="M12 5v14M5 12h14" />
                    </svg>
                  </span>
                  <span class="compositor__texto">Pregunta algo</span>
                  <span class="selector">Claude Sonnet ⌄</span>
                  <span class="tecla-redonda tecla-redonda--enviar" aria-hidden="true">
                    <svg class="icono" viewBox="0 0 24 24">
                      <path d="M12 19V5M5 12l7-7 7 7" />
                    </svg>
                  </span>
                </div>
              </div>

              <p class="consumo">
                <span>Claude</span>
                <span class="medidor" aria-hidden="true">
                  <span class="medidor__lleno" style="width: 78%;"></span>
                </span>
                <span>78 % resta</span>
                <span class="franja-larga">· repone en 2 h 14 min</span>
              </p>
            </div>

            <!-- Artefactos: lo que salió de la tarea, separado de lo que entró.
                 Aquí se ve el contrato del producto — lo adjuntado va marcado
                 `solo lectura`, y lo escrito vive en la carpeta de trabajo. -->
            <div class="panel panel--der">
              <p class="franja__titulo" style="padding: 0.25rem;">Artefactos (3)</p>

              <p class="panel__rotulo" style="margin-top: 0.4rem;">
                Producido en esta tarea
              </p>
              <p class="artefacto">
                <span class="sello sello--salida">salida</span>
                <span class="artefacto__ruta">cambio-de-plan.md</span>
                <span class="artefacto__peso">12,4 kB</span>
              </p>

              <p class="panel__rotulo" style="margin-top: 0.6rem;">
                Lo que adjuntaste
              </p>
              <p class="artefacto">
                <span class="sello sello--entrada">entrada</span>
                <span class="artefacto__ruta">acme-api</span>
                <span class="artefacto__peso">solo lectura</span>
              </p>
              <p class="artefacto">
                <span class="sello sello--entrada">entrada</span>
                <span class="artefacto__ruta">docs-producto</span>
                <span class="artefacto__peso">solo lectura</span>
              </p>

              <p class="boton-fantasma">Abrir carpeta de trabajo</p>
            </div>
          </div>
        </figure>
      </section>

      <!-- ================================================================
           El problema. Después de la captura: primero se ve la cosa, luego
           se dice por qué hacía falta.
           =============================================================== -->
      <section class="envoltura seccion" style="margin-top: clamp(3rem, 6vw, 5rem);">
        <div class="encabezado-seccion" style="margin-bottom: 2.5rem;">
          <p class="rotulo">Qué es</p>
          <h2>Una aplicación de escritorio donde el agente no puede escribir tu repo.</h2>
        </div>
        <div class="dos-columnas">
          <p class="suave">
            Claude Code y Codex corren dentro de la aplicación. Git y los CLI
            de los agentes vienen incluidos. No instalas ni configuras nada
            en tu sistema.
          </p>
          <p class="suave">
            Conectas los repositorios de tu organización y entran en
            <strong>solo lectura</strong>. El agente no tiene permiso de
            escritura sobre ellos. Lee ahí y escribe en una carpeta de
            trabajo aparte.
          </p>
        </div>
      </section>

      <!-- ================================================================
           Cómo funciona. Tres pasos numerados, cada uno con el dato de la
           app debajo — no el texto solo.
           =============================================================== -->
      <section class="envoltura seccion">
        <div class="encabezado-seccion">
          <p class="rotulo">Cómo funciona</p>
          <h2>Conecta, lee, produce. Nunca escribe.</h2>
          <p class="suave">
            Tres pasos. El repositorio no se escribe en ninguno. El agente
            no tiene ese permiso.
          </p>
        </div>

        <ol class="pasos">
          <li class="paso">
            <span class="paso__num">01</span>
            <h3>Conectas un repositorio</h3>
            <p>
              Lo señalas y entra como contexto de solo lectura, sin permiso de
              escritura. No se clona en tu sistema ni se modifica.
            </p>
            <div class="paso__visual">
              <p class="dato">
                <svg class="icono" viewBox="0 0 24 24" aria-hidden="true">
